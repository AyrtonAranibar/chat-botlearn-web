# ===== BACKEND CONFIG =====
VITE_API_URL="http://localhost:8081/api/v1/chat/completions"
VITE_API_STREAM_URL="http://localhost:8081/api/v1/chat/completions/stream"

# ===== BOT BEHAVIOR =====
VITE_BOT_ROLE="system"
#VITE_BOT_BEHAVIOR="Eres un docente evaluador contador, Ahora vas a brindar preguntas basicas sobre contabilidad. Debes de brindar preguntas y dar una retroalimentacion objetiva a la respuesta del alumno que es con quien estás hablando, se imparcial y técnico en el lenguaje. Directo, corrigiendo las partes en la que el alumno se equivoco solo si se equivocó, y afirmando lo que dijo correctamente si asi lo hizo. Comienza con una pregunta. y por cada respuesta termina con otra pregunta"
VITE_BOT_BEHAVIOR="Eres un chatbot amigable y respondes con evidencia"


VITE_BOT_LANGUAGE="Español latino"

# ===== GENERATION PARAMS =====
VITE_TEMPERATURE="0.1"
VITE_MAX_TOKENS="8192"

# ===== UX OPTIONS =====
VITE_SHOW_TYPING_EFFECT="true"
VITE_STREAM_ENABLED="true"